<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- RGB Camera Sensor Configuration -->
  <xacro:macro name="rgb_camera" params="name parent_link *origin topic update_rate width height fov format near far">
    <gazebo reference="${parent_link}">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <camera name="head">
          <horizontal_fov>${fov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>${format}</format>
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="${name}_controller" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>${update_rate}</updateRate>
          <cameraName>${name}</cameraName>
          <imageTopicName>${topic}/image_raw</imageTopicName>
          <cameraInfoTopicName>${topic}/camera_info</cameraInfoTopicName>
          <frameName>${parent_link}</frameName>
          <hackBaseline>0.07</hackBaseline>
          <distortion_k1>0.0</distortion_k1>
          <distortion_k2>0.0</distortion_k2>
          <distortion_k3>0.0</distortion_k3>
          <distortion_t1>0.0</distortion_t1>
          <distortion_t2>0.0</distortion_t2>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Depth Camera Sensor Configuration -->
  <xacro:macro name="depth_camera" params="name parent_link *origin rgb_topic depth_topic update_rate width height fov near far">
    <gazebo reference="${parent_link}">
      <sensor name="${name}" type="depth">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <camera name="depth_camera">
          <horizontal_fov>${fov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="${name}_controller" filename="libgazebo_ros_openni_kinect.so">
          <baseline>0.2</baseline>
          <alwaysOn>true</alwaysOn>
          <updateRate>${update_rate}</updateRate>
          <cameraName>${name}</cameraName>
          <imageTopicName>${rgb_topic}/image_raw</imageTopicName>
          <depthImageTopicName>${depth_topic}/image_raw</depthImageTopicName>
          <pointCloudTopicName>${depth_topic}/points</pointCloudTopicName>
          <cameraInfoTopicName>${rgb_topic}/camera_info</cameraInfoTopicName>
          <depthImageCameraInfoTopicName>${depth_topic}/camera_info</depthImageCameraInfoTopicName>
          <frameName>${parent_link}</frameName>
          <pointCloudCutoff>0.1</pointCloudCutoff>
          <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
          <distortion_k1>0.0</distortion_k1>
          <distortion_k2>0.0</distortion_k2>
          <distortion_k3>0.0</distortion_k3>
          <distortion_t1>0.0</distortion_t1>
          <distortion_t2>0.0</distortion_t2>
          <CxPrime>0</CxPrime>
          <Cx>0</Cx>
          <Cy>0</Cy>
          <focalLength>0</focalLength>
          <hackBaseline>0</hackBaseline>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Example usage of the camera macros -->
  <xacro:rgb_camera
    name="front_camera"
    parent_link="camera_mount"
    topic="/front_camera"
    update_rate="30"
    width="800"
    height="600"
    fov="1.047"  <!-- 60 degrees -->
    format="R8G8B8"
    near="0.1"
    far="100">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:rgb_camera>

  <xacro:depth_camera
    name="depth_camera"
    parent_link="camera_mount"
    rgb_topic="/depth_camera/rgb"
    depth_topic="/depth_camera/depth"
    update_rate="30"
    width="640"
    height="480"
    fov="1.047"  <!-- 60 degrees -->
    near="0.1"
    far="10">
    <origin xyz="0.05 0 0" rpy="0 0 0"/>  <!-- Offset from RGB camera for stereo effect -->
  </xacro:depth_camera>
</robot>