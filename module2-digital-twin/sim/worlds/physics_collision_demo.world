<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="physics_collision_demo">
    <!-- Include default sun and ground plane -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Physics configuration -->
    <physics name="default_physics" type="ode">
      <gravity>0 0 -9.8</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Newton's Cradle - demonstrates momentum conservation -->
    <model name="newtons_cradle">
      <!-- First sphere -->
      <model name="sphere_1">
        <pose>-2 0 2 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
            <material>
              <ambient>1 0 0 1</ambient>
              <diffuse>1 0 0 1</diffuse>
            </material>
          </visual>
          <collision name="collision">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
          </collision>
          <inertial>
            <mass>1.0</mass>
            <inertia>
              <ixx>0.004</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.004</iyy>
              <iyz>0</iyz>
              <izz>0.004</izz>
            </inertia>
          </inertial>
        </link>
        <joint name="joint_1" type="revolute">
          <parent>world</parent>
          <child>link</child>
          <axis>
            <xyz>0 1 0</xyz>
          </axis>
          <pose>-2 0 3 0 0 0</pose>
        </joint>
      </model>

      <model name="sphere_2">
        <pose>-1.8 0 2 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
            <material>
              <ambient>0 1 0 1</ambient>
              <diffuse>0 1 0 1</diffuse>
            </material>
          </visual>
          <collision name="collision">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
          </collision>
          <inertial>
            <mass>1.0</mass>
            <inertia>
              <ixx>0.004</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.004</iyy>
              <iyz>0</iyz>
              <izz>0.004</izz>
            </inertia>
          </inertial>
        </link>
        <joint name="joint_2" type="revolute">
          <parent>world</parent>
          <child>link</child>
          <axis>
            <xyz>0 1 0</xyz>
          </axis>
          <pose>-1.8 0 3 0 0 0</pose>
        </joint>
      </model>

      <model name="sphere_3">
        <pose>-1.6 0 2 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
            <material>
              <ambient>0 0 1 1</ambient>
              <diffuse>0 0 1 1</diffuse>
            </material>
          </visual>
          <collision name="collision">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
          </collision>
          <inertial>
            <mass>1.0</mass>
            <inertia>
              <ixx>0.004</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.004</iyy>
              <iyz>0</iyz>
              <izz>0.004</izz>
            </inertia>
          </inertial>
        </link>
        <joint name="joint_3" type="revolute">
          <parent>world</parent>
          <child>link</child>
          <axis>
            <xyz>0 1 0</xyz>
          </axis>
          <pose>-1.6 0 3 0 0 0</pose>
        </joint>
      </model>

      <model name="sphere_4">
        <pose>-1.4 0 2 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
            <material>
              <ambient>1 1 0 1</ambient>
              <diffuse>1 1 0 1</diffuse>
            </material>
          </visual>
          <collision name="collision">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
          </collision>
          <inertial>
            <mass>1.0</mass>
            <inertia>
              <ixx>0.004</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.004</iyy>
              <iyz>0</iyz>
              <izz>0.004</izz>
            </inertia>
          </inertial>
        </link>
        <joint name="joint_4" type="revolute">
          <parent>world</parent>
          <child>link</child>
          <axis>
            <xyz>0 1 0</xyz>
          </axis>
          <pose>-1.4 0 3 0 0 0</pose>
        </joint>
      </model>

      <model name="sphere_5">
        <pose>-1.2 0 2 0 0 0</pose>
        <link name="link">
          <visual name="visual">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
            <material>
              <ambient>1 0 1 1</ambient>
              <diffuse>1 0 1 1</diffuse>
            </material>
          </visual>
          <collision name="collision">
            <geometry>
              <sphere>
                <radius>0.1</radius>
              </sphere>
            </geometry>
          </collision>
          <inertial>
            <mass>1.0</mass>
            <inertia>
              <ixx>0.004</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.004</iyy>
              <iyz>0</iyz>
              <izz>0.004</izz>
            </inertia>
          </inertial>
        </link>
        <joint name="joint_5" type="revolute">
          <parent>world</parent>
          <child>link</child>
          <axis>
            <xyz>0 1 0</xyz>
          </axis>
          <pose>-1.2 0 3 0 0 0</pose>
        </joint>
      </model>
    </model>

    <!-- Bouncing balls with different restitution values -->
    <model name="bouncy_sphere">
      <pose>1 0 3 0 0 0</pose>
      <link name="sphere_link">
        <visual name="sphere_visual">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
          </material>
        </visual>
        <collision name="sphere_collision">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <surface>
            <bounce>
              <restitution_coefficient>0.9</restitution_coefficient>
              <threshold>100000</threshold>
            </bounce>
          </surface>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="not_so_bouncy_sphere">
      <pose>1.5 0 3 0 0 0</pose>
      <link name="sphere_link">
        <visual name="sphere_visual">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.5 0 1 1</ambient>
            <diffuse>0.5 0 1 1</diffuse>
          </material>
        </visual>
        <collision name="sphere_collision">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <surface>
            <bounce>
              <restitution_coefficient>0.2</restitution_coefficient>
              <threshold>100000</threshold>
            </bounce>
          </surface>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Ramps to demonstrate different physics concepts -->
    <model name="friction_ramp_1">
      <pose>2 1 0 0 0.5 0</pose>
      <link name="ramp_link">
        <visual name="ramp_visual">
          <geometry>
            <box>
              <size>2 0.5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="ramp_collision">
          <geometry>
            <box>
              <size>2 0.5 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>10</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>10</iyy>
            <iyz>0</iyz>
            <izz>10</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="friction_ramp_2">
      <pose>2 -1 0 0 0.5 0</pose>
      <link name="ramp_link">
        <visual name="ramp_visual">
          <geometry>
            <box>
              <size>2 0.5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="ramp_collision">
          <geometry>
            <box>
              <size>2 0.5 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>10</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>10</iyy>
            <iyz>0</iyz>
            <izz>10</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Objects to place on ramps -->
    <model name="ramp_object_1">
      <pose>2 1 0.5 0 0 0</pose>
      <link name="object_link">
        <visual name="object_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 1 1</ambient>
            <diffuse>0 1 1 1</diffuse>
          </material>
        </visual>
        <collision name="object_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0015</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0015</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="ramp_object_2">
      <pose>2 -1 0.5 0 0 0</pose>
      <link name="object_link">
        <visual name="object_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 1 1</ambient>
            <diffuse>0 1 1 1</diffuse>
          </material>
        </visual>
        <collision name="object_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.2</length>
            </cylinder>
          </geometry>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0015</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0015</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>
  </world>
</sdf>