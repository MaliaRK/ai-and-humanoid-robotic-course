            {
                float3 size = (0.05, 0.05, 0.7)
                float3 xformOp:translate = (-0.45, -0.35, 0.35)
                color3f[] displayColor = [(0.6, 0.4, 0.2)]
            }
        }

        def Xform "Box"
        {
            float3 xformOp:translate = (2.0, 0.2, 0.0)
            def Cube "BoxShape"
            {
                float3 size = (0.4, 0.4, 0.4)
                color3f[] displayColor = [(0.2, 0.6, 0.2)]
            }
        }
    }

    def Xform "Lighting"
    {
        def DomeLight "DomeLight"
        {
            color3f inputs:color = (0.2, 0.2, 0.2)
            float inputs:intensity = 3000
        }

        def DistantLight "KeyLight"
        {
            color3f inputs:color = (1.0, 0.95, 0.9)
            float inputs:intensity = 500
            float3 xformOp:rotateXYZ = (-15, 45, 0)
        }
    }
}