        def Xform "LeftLeg"
        {
            add prepend references = </World/HumanoidRobot/Pelvis>
            def Capsule "UpperLegShape"
            {
                float radius = 0.08
                float height = 0.35
                color3f[] displayColor = [(0.4, 0.4, 0.7)]
            }
            def Capsule "LowerLegShape"
            {
                float radius = 0.07
