    def Xform "EnvironmentObjects"
    {
        def Xform "Table"
        {
            def Cube "TableTop"
            {
                float3 size = (1.0, 0.8, 0.8)
                color3f[] displayColor = [(0.6, 0.4, 0.2)]
            }
            def Cube "TableLeg1"
            {
                float3 size = (0.05, 0.05, 0.7)
                float3 xformOp:translate = (0.45, -0.35, -0.35)
                color3f[] displayColor = [(0.6, 0.4, 0.2)]
            }
            def Cube "TableLeg2"
            {
                float3 size = (0.05, 0.05, 0.7)
                float3 xformOp:translate = (-0.45, -0.35, -0.35)
                color3f[] displayColor = [(0.6, 0.4, 0.2)]
            }
